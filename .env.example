# Service URLs
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here
JELLYFIN_URL=http://localhost:8096
# Find at: Dashboard > API Keys > Create (32-char hex, no trailing == or padding)
JELLYFIN_API_KEY=your_jellyfin_api_key_here
SEERR_URL=http://localhost:5055
SEERR_API_KEY=your_seerr_api_key_here
SEERR_USER_ID=
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=your_sabnzbd_api_key_here
# Must be Jellyfin UUIDs, NOT display names. Find at: Dashboard > Users > click user > ID is in the URL
# Example: 5e2b20b33b024a7f8bd3e6378e8c8978,012b92086ae14c2e918ae76cf2d43d0a
JELLYFIN_USER_IDS=user_uuid_1,user_uuid_2

# Settings
WATCH_THRESHOLD=0.75
RUN_INTERVAL_MINUTES=15
NEW_SERIES_LOOKBACK_HOURS=48
DRY_RUN=false
LOG_LEVEL=INFO
RUN_CATCHUP_ON_START=false
WEBHOOK_PORT=9191
# Optional: override the SQLite data dir bind mount. Defaults to ./data (relative
# to docker-compose.yml). Set to an absolute path if your `docker compose`
# invocation may run from a non-canonical cwd (e.g. some Unraid setups) so the
# bind mount stays pinned to a real host path regardless of cwd.
#
# This folder holds the SQLite DB and the Trakt OAuth token on the HOST, so the
# container is disposable: renaming/recreating it (stop -> rm -> up -d) is safe
# as long as you keep THIS same mapping. Do not change it to a new path or you'll
# orphan your existing DB and have to re-authenticate Trakt.
#
# RECOMMENDED: use a cache/pool-backed path, not the Unraid FUSE share
# (/mnt/user/...). SQLite WAL locking can be flaky on shfs/FUSE and surface as
# "database is locked"/readonly errors.
# DATA_DIR=/mnt/cache/appdata/cascade-media
SABNZBD_QUEUE_WAIT_SECONDS=120
PLAYBACK_CHECK_INTERVAL=45
PLAYBACK_SCRIPT_TIMEOUT=600
# Subprocess timeouts. media_automation.py runs (poll/webhook) get
# SCRIPT_TIMEOUT_MINUTES minutes; trakt_discovery.py runs get TRAKT_SCRIPT_TIMEOUT
# seconds. Both have working defaults — uncomment only if you need to override.
# SCRIPT_TIMEOUT_MINUTES=30
# TRAKT_SCRIPT_TIMEOUT=300

# Trakt Content Discovery
# Create an app at https://trakt.tv/oauth/applications to get client ID/secret
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_DISCOVERY_ENABLED=false
# HH:MM local time - time of day to run daily discovery
TRAKT_DISCOVERY_TIME=00:00
# IANA timezone (e.g. America/Chicago, America/New_York, America/Los_Angeles)
TRAKT_DISCOVERY_TZ=UTC
TRAKT_DISCOVER_SHOWS=true
TRAKT_DISCOVER_MOVIES=true
TRAKT_LISTS=recommended,watchlist,trending,popular,anticipated
TRAKT_MIN_RATING=7.0
TRAKT_MIN_VOTES=100
# Format: 2020-2026 (MIN-MAX year range, empty = no filter)
TRAKT_YEARS=
# Format: drama,comedy,thriller (lowercase Trakt slugs, comma-separated, empty = no filter)
TRAKT_GENRES=
# Format: en,es,fr (ISO 639-1 two-letter codes, comma-separated)
TRAKT_LANGUAGES=en
TRAKT_MAX_REQUESTS_PER_CYCLE=10
TRAKT_MAX_SHOW_REQUESTS=5
TRAKT_MAX_MOVIE_REQUESTS=5
TRAKT_ITEMS_PER_LIST=20

# Cross-list priority — items appearing on both a source and target list are processed first
# This prioritises high-confidence picks (e.g. recommended AND trending) before filling remaining slots
TRAKT_CROSS_LIST_PRIORITY=true
# Which lists provide the "personal signal" (comma-separated)
TRAKT_CROSS_LIST_SOURCES=recommended,watchlist
# Which lists provide the "popularity signal" (comma-separated)
TRAKT_CROSS_LIST_TARGETS=trending

# Genre exclusion — skip items matching these genres (comma-separated, lowercase)
# Common values: animation,reality,talk-show,game-show,news,soap
TRAKT_EXCLUDE_GENRES=

# Content rating filters — uses Trakt certification field directly, NO TMDB key required
# Certification reflects the content's origin country rating (typically US for US content)
# TV values: TV-Y, TV-Y7, TV-G, TV-PG, TV-14, TV-MA
# Movie values: G, PG, PG-13, R, NC-17
# allow-list: only these ratings pass (empty = all allowed)
FILTER_CONTENT_RATINGS=
# deny-list: skip items with these ratings (empty = none blocked)
FILTER_EXCLUDE_CONTENT_RATINGS=

# TMDB filters (optional — requires a free TMDB API key from https://www.themoviedb.org/settings/api)
# These filters use TMDB data for episode count, show status, show type, networks, and season count
# ⚠ BREAKING CHANGE (v8): TRAKT_MAX_EPISODES     → TMDB_MAX_EPISODES
#                          TRAKT_ALLOWED_SHOW_STATUS → TMDB_ALLOWED_SHOW_STATUS
TMDB_API_KEY=
# Skip shows with more than this many episodes (0 = disabled)
TMDB_MAX_EPISODES=0
# Only allow shows with these statuses (comma-separated, empty = all)
# Values: Returning Series, Planned, In Production, Ended, Canceled, Pilot
TMDB_ALLOWED_SHOW_STATUS=
# Skip shows of these types (comma-separated, empty = all types allowed)
# TMDB type values: Scripted, Miniseries, Documentary, Reality, News, Talk Show
TMDB_EXCLUDE_SHOW_TYPES=
# Only allow shows from these networks (comma-separated, empty = all networks)
# Names are case-sensitive and must match TMDB exactly. See network reference below.
TMDB_ALLOWED_NETWORKS=
# Skip shows from these networks (comma-separated, exact TMDB spelling)
# Inverse of TMDB_ALLOWED_NETWORKS — use one or the other (or both for layered filtering)
TMDB_DISALLOWED_NETWORKS=
#
# TMDB Network Name Reference (case-sensitive, must match exactly):
#   Streaming:  Netflix, Amazon Prime Video, Apple TV, Disney+, Hulu,
#               Max, Peacock, Paramount+, Crunchyroll, Tubi, Pluto TV,
#               BritBox, Shudder, AMC+, discovery+, MGM+, Starz,
#               fuboTV, Freevee
#   Premium:    HBO, Showtime, Starz, Cinemax, EPIX
#   Broadcast:  NBC, CBS, ABC (US), FOX, The CW, PBS
#   Cable:      FX, FXX, AMC, USA Network, TNT, TBS, Syfy, Bravo,
#               A&E, History, Lifetime, MTV, Comedy Central, BET,
#               Cartoon Network, Adult Swim, Hallmark Channel,
#               National Geographic, BBC America, Freeform
#   UK:         BBC One, BBC Two, BBC Three, ITV, Channel 4, Channel 5, Sky Atlantic
#   Other:      NHK, TV Tokyo, Canal+, ZDF, ARD
#   NOTE: "HBO Max" was rebranded to "Max" on TMDB — use "Max" not "HBO Max"
#   NOTE: "Apple TV+" was rebranded to "Apple TV" on TMDB — use "Apple TV"
#
# Skip shows currently streaming on these subscription providers in your region.
# RECOMMENDED over TMDB_DISALLOWED_NETWORKS: uses the TMDB Watch Providers API,
# which tracks the actual streaming distributor — catches shows like Bodyguard
# (originating on BBC One, distributed by Netflix) that the networks filter misses,
# and survives network-name rebrands.
# SHOWS ONLY — movies are unaffected (theatrical releases often have higher-quality
# non-streaming versions available even when also on a subscription service).
# Match is case-sensitive startswith — "Apple TV" catches "Apple TV Amazon Channel"
# but "Max" does NOT catch "Cinemax".
# Examples: Netflix, Apple TV, HBO Max, Max, Disney Plus, Hulu, Amazon Prime Video
TMDB_DISALLOWED_PROVIDERS=
# Region for watch provider lookup (ISO 3166-1 country code, default US)
TMDB_PROVIDER_REGION=US
# Skip shows with more than this many seasons (0 = disabled; complements TMDB_MAX_EPISODES)
TMDB_MAX_SEASONS=0
# Original language filter — checks TMDB's original_language field (ISO 639-1 codes)
# More accurate than TRAKT_LANGUAGES which reflects metadata language, not production language
# Applies to both shows and movies. Common codes: en, ko, fr, de, ja, es, pt, zh
# Leave empty to allow all languages (default behaviour)
TMDB_ORIGINAL_LANGUAGE=

# Seerr recheck window — days before a skipped_exists record expires so auto-deleted content
# can be re-discovered and re-requested. 0 = permanent (never re-check).
# Useful with auto-deletion tools (e.g. Jellysweep) — content purged from your library
# will re-enter the discovery pipeline after this many days and may be re-requested.
TRAKT_SEERR_RECHECK_DAYS=365

# Premium Content Bypass
# High-rated content from configured lists can bypass year and/or show status filters
# TRAKT_MIN_RATING (7.0) still applies as the floor — bypass only overrides year/status
TRAKT_PREMIUM_BYPASS_ENABLED=true
TRAKT_PREMIUM_BYPASS_MIN_RATING=8.0
# comma-separated list names
TRAKT_PREMIUM_BYPASS_LISTS=recommended,watchlist
# year, status, or year,status
TRAKT_PREMIUM_BYPASS_FILTERS=year,status

# Alerts (optional) — fire ONLY on Trakt token refresh failure requiring manual re-auth.
# Two independent channels: webhook (Discord/Slack/ntfy.sh) and email (SMTP).
# Configure either, both, or neither. Test with: python trakt_discovery.py test-alert
#
# Channel 1: Webhook — supports Discord (content field), Slack (text field), ntfy.sh
ALERT_WEBHOOK_URL=
#
# Channel 2: Email via SMTP. Gmail setup: enable 2FA, generate an App Password at
# https://myaccount.google.com/apppasswords, then fill in below. To make alerts
# notify you despite Gmail notifications being off: create a Gmail filter on
# subject contains "[Cascade Media Alert]" → apply a label (e.g. "Cascade Alerts"),
# then in Gmail iOS → Settings → [account] → Label notifications → enable that label.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_SUBJECT_PREFIX=[Cascade Media Alert]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
